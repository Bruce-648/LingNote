<Window x:Class="LingNote.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LingNote" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStyle="None" Title="LingNote" Icon="Assets/app.ico" Width="1160" Height="780" MinWidth="920" MinHeight="620" WindowStartupLocation="CenterScreen">
<shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="10" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
<Window.Resources><Style x:Key="HistoryAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Hidden"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style><DrawingImage x:Key="MoreDots"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 24,24 0,24 Z"/><GeometryDrawing Brush="#858585"><GeometryDrawing.Geometry><GeometryGroup><EllipseGeometry Center="6,12" RadiusX="1.3" RadiusY="1.3"/><EllipseGeometry Center="12,12" RadiusX="1.3" RadiusY="1.3"/><EllipseGeometry Center="18,12" RadiusX="1.3" RadiusY="1.3"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing></DrawingGroup></DrawingImage.Drawing></DrawingImage><DataTemplate x:Key="MoreDotsTemplate"><Image Source="{StaticResource MoreDots}" Width="18" Height="18"/></DataTemplate></Window.Resources>
<Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Row="1" x:Name="Sidebar" Background="#FAFAFA" BorderBrush="#EEEEEE" BorderThickness="0,0,1,0"><DockPanel Margin="14,24,14,16">
<StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" Margin="8,0,0,22" Height="36"><Image RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Source="Assets/app-logo.png" Width="34" Height="34" Margin="0,0,8,0"/><Image RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Source="Assets/wordmark.png" Width="140" Height="32" Stretch="Uniform"/></StackPanel><Button x:Name="NewButton" Content="＋ 新录音" Click="New_Click" HorizontalContentAlignment="Left"/></StackPanel>
<Button x:Name="SettingsButton" DockPanel.Dock="Bottom" Content="设置" Click="Settings_Click" HorizontalContentAlignment="Left" Background="Transparent" Margin="0,16,0,0"/>
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><Grid x:Name="TopicsHeaderRow" Background="Transparent" Margin="10,24,0,6"><Button x:Name="TopicsHeader" Click="TopicsToggle_Click" HorizontalAlignment="Left" Margin="-10,0,0,0" Padding="10,4" Background="Transparent" Foreground="#929292"/><Button x:Name="AddTopicButton" Click="AddTopic_Click" ToolTip="创建主题" HorizontalAlignment="Right" Padding="4" Width="28" Height="28" Margin="0" Background="Transparent"/></Grid>
<ScrollViewer x:Name="TopicsScroll" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="EmptyTopics"/></ScrollViewer><Grid x:Name="UnassignedHeaderRow" Background="Transparent" DockPanel.Dock="Top" Margin="0,22,0,8"><Button x:Name="GroupButton" Click="UnassignedToggle_Click" HorizontalAlignment="Left" Background="Transparent" Foreground="#929292" Padding="10,4" Margin="0"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button x:Name="UnassignedMore" Content="more" ContentTemplate="{StaticResource MoreDotsTemplate}" Click="Group_Click" ToolTip="列表显示方式" Width="28" Height="28" Padding="4" Margin="0" Background="Transparent"/><Button x:Name="UnassignedNew" Click="NewUnassigned_Click" ToolTip="新建未分区录音" Width="28" Height="28" Padding="4" Margin="0" Background="Transparent"/></StackPanel></Grid>
<ListBox IsSynchronizedWithCurrentItem="False" x:Name="History" Background="Transparent" BorderThickness="0" SelectionChanged="History_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
<ListBox.Template><ControlTemplate TargetType="ListBox"><Border Background="Transparent" BorderThickness="0"><ScrollViewer Focusable="False" Background="Transparent" Padding="0" CanContentScroll="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer></Border></ControlTemplate></ListBox.Template>
<ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="#939393" FontSize="11" Margin="10,14,0,5"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
<ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,2,0,2"/><Setter Property="Margin" Value="0,1"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><EventSetter Event="MouseRightButtonUp" Handler="History_RightClick"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#F0F0F0"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#EFEFEF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
<ListBox.ItemTemplate><DataTemplate><DockPanel><Border DockPanel.Dock="Right" Width="28"/><Button Style="{StaticResource HistoryAction}" DockPanel.Dock="Right" Width="28" Height="28" Content="more" ContentTemplate="{StaticResource MoreDotsTemplate}" ToolTip="录音操作" Padding="4" Margin="0" Background="Transparent" Click="RecordMore_Click"/><TextBlock VerticalAlignment="Center" Text="{Binding Title}" FontSize="14" Foreground="#404040" TextTrimming="CharacterEllipsis" ToolTip="{Binding Caption}"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
</ListBox>
<Button x:Name="UnassignedExpand" Content="展开显示" Click="UnassignedExpand_Click" Visibility="Collapsed" HorizontalAlignment="Left" Background="Transparent" Foreground="Gray" Padding="10,6" Margin="0,4,0,0"/>
<StackPanel x:Name="CustomSections"/>
</StackPanel></ScrollViewer></DockPanel></Border>
<Grid Grid.Row="1" Grid.Column="1" Margin="32,22,32,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBox x:Name="TitleBox" Text="新录音" FontSize="25" FontWeight="SemiBold" BorderThickness="0" Padding="0,5" LostFocus="Title_Changed"/><TextBlock x:Name="Meta" Text="系统声音" Foreground="#939393" FontSize="12" Margin="0,7,0,0"/></StackPanel>
<Border x:Name="RecorderCard" Grid.Row="1" Background="#FAFAFA" BorderBrush="#EEEEEE" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,24,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StatusLabel" Text="准备录音" Foreground="#858585" FontSize="12"/><Grid Margin="0,10,18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="TimerLabel" Text="00:00:00" FontSize="27" FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/><local:Waveform x:Name="LevelBar" Grid.Column="1" Height="40" Margin="24,0,0,0" MaxWidth="300"/></Grid></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="StartButton" Content="开始录音" Style="{StaticResource Primary}" Click="Start_Click" Padding="20,12"/><Button x:Name="PauseButton" Click="Pause_Click" Visibility="Collapsed" Padding="12" ToolTip="暂停或继续"/><Button x:Name="StopButton" Content="结束" Click="Stop_Click" Visibility="Collapsed" Padding="12" ToolTip="结束并整理"/></StackPanel></Grid></Border>
<Grid x:Name="NoteTools" Grid.Row="2" Margin="0,0,0,12" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="NoteTab" Content="笔记" Click="NoteTab_Click" Padding="12,7"/><Button x:Name="TranscriptTab" Content="转写" Click="TranscriptTab_Click" Padding="12,7" Background="Transparent"/><CheckBox x:Name="EditToggle" Content="编辑" VerticalAlignment="Center" Margin="14,0,0,0" Checked="Edit_Changed" Unchecked="Edit_Changed"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="CopyButton" Content="复制" Click="Copy_Click" Padding="12,7" Background="Transparent"/><Button x:Name="ExportButton" Content="导出" Click="Export_Click" Padding="12,7"/></StackPanel></Grid>
<Border Grid.Row="3" BorderBrush="#EEEEEE" BorderThickness="1" CornerRadius="14"><Grid>
<FlowDocumentScrollViewer x:Name="Preview" FocusVisualStyle="{x:Null}" IsToolBarVisible="False" VerticalScrollBarVisibility="Auto" Padding="14"/>
<TextBox x:Name="Editor" Visibility="Collapsed" TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" Padding="22" BorderThickness="0" FontFamily="{StaticResource AppFont}" TextChanged="Editor_Changed"/>
<StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Margin="30"><TextBlock x:Name="EmptyTitle" Text="准备好就开始" FontSize="20" Foreground="#737373" HorizontalAlignment="Center"/><TextBlock x:Name="EmptySubtitle" Text="播放课程，点击上方开始录音" TextAlignment="Center" Foreground="#A3A3A3" Margin="0,12,0,0"/></StackPanel>
</Grid></Border>
<Grid Grid.Row="4" Margin="0,10,0,0" MinHeight="30"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><local:ProcessingIndicator x:Name="ProcessingHint" VerticalAlignment="Center"/><TextBlock x:Name="Hint" Foreground="#858585" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="CancelButton" Content="取消处理" Click="Cancel_Click" Visibility="Collapsed" Padding="12,7"/><Button x:Name="GenerateButton" Content="继续整理" Click="Generate_Click" Visibility="Collapsed" Padding="12,7"/></StackPanel></Grid>
</Grid><Border Grid.Row="0" Grid.ColumnSpan="2" Background="#FAFAFA"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button x:Name="MinimizeCaption" Click="MinimizeCaption_Click" Width="44" Height="38" Padding="12" Margin="0" Background="Transparent" ToolTip="最小化"/><Button x:Name="MaximizeCaption" Click="MaximizeCaption_Click" Width="44" Height="38" Padding="12" Margin="0" Background="Transparent" ToolTip="最大化或还原"/><Button x:Name="CloseCaption" Click="CloseCaption_Click" Width="44" Height="38" Padding="12" Margin="0" Background="Transparent" ToolTip="关闭"/></StackPanel><StackPanel HorizontalAlignment="Left" shell:WindowChrome.IsHitTestVisibleInChrome="True" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"><Button x:Name="SidebarToggle" Width="30" Height="30" Click="SidebarToggle_Click" ToolTip="收起或展开侧栏" Padding="6" Margin="0,0,12,0" Background="#ECEEEF"/><Button Content="应用" Click="AppMenu_Click" Padding="10,6" Margin="0,0,4,0" Background="Transparent" Foreground="#666666" FontSize="13"/><Button Content="编辑" Click="EditMenu_Click" Padding="10,6" Margin="0" Background="Transparent" Foreground="#666666" FontSize="13"/></StackPanel></DockPanel></Border><Border x:Name="WindowOutline" Grid.RowSpan="2" Grid.ColumnSpan="2" BorderBrush="#C7C7C7" BorderThickness="1" CornerRadius="10" IsHitTestVisible="False"/></Grid></Window>
